# ============================================================
# RAG Chatbot — .gitignore
# ============================================================
# Files listed here are NEVER committed to git.
# This protects API keys, build artifacts, and local config.

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.local
.env.production

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
myenv/
env/
.eggs/

# --- ChromaDB data (generated at runtime) ---
backend/chroma_data/

# --- Node / Frontend ---
node_modules/
extension/dist/
extension/.cache/
*.local

# --- Vite ---
dist-ssr/
*.tsbuildinfo

# --- IDEs ---
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
