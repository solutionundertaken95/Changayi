# ============================================================
# RAG Chatbot — Environment Variable Reference
# ============================================================
# This file IS committed to git — it documents what variables exist
# WITHOUT revealing real values.
#
# Setup instructions:
#   1. Copy this file:   cp .env.example backend/.env
#   2. Fill in your real values below
#   3. Never commit backend/.env

# --- Gemini API Key ---
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Server ---
HOST=127.0.0.1
PORT=8000

# --- ChromaDB (local storage for embeddings) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- HuggingFace Embedding Model (runs locally, no API key needed) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Text Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
