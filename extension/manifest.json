{
  "manifest_version": 3,
  "name": "RAG Chatbot",
  "version": "0.1.0",
  "description": "Ask AI questions about any webpage you are reading",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.tsx"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
